{
  "framework": "vite",
  "installCommand": "cd ../.. && corepack pnpm@10.34.5 install --frozen-lockfile",
  "buildCommand": "cd ../.. && corepack pnpm@10.34.5 --filter @exaearn/developers build",
  "outputDirectory": "dist",
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs developers",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
