{
  "name": "exaearn-blockchain-service",
  "version": "1.0.0",
  "description": "ExaEarn Node.js blockchain monitoring, transaction broadcasting, and smart contract workspace",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:giftcard": "node dist/nest/main.js",
    "dev": "nodemon src/index.js",
    "build:giftcard": "tsc -p tsconfig.json",
    "lint": "eslint src/",
    "test": "jest --runInBand",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "contracts:deploy:base-sepolia": "hardhat run scripts/deploy.js --network baseSepolia",
    "contracts:deploy:bsc-testnet": "hardhat run scripts/deploy.js --network bscTestnet",
    "contracts:deploy:ethereum": "hardhat run scripts/deploy.js --network ethereum",
    "contracts:deploy:base": "hardhat run scripts/deploy.js --network base",
    "contracts:deploy:bsc": "hardhat run scripts/deploy.js --network bsc",
    "contracts:verify:sepolia": "hardhat run scripts/verify-deployment.js --network sepolia",
    "contracts:verify:base-sepolia": "hardhat run scripts/verify-deployment.js --network baseSepolia",
    "contracts:verify:bsc-testnet": "hardhat run scripts/verify-deployment.js --network bscTestnet",
    "contracts:verify:ethereum": "hardhat run scripts/verify-deployment.js --network ethereum",
    "contracts:verify:base": "hardhat run scripts/verify-deployment.js --network base",
    "contracts:verify:bsc": "hardhat run scripts/verify-deployment.js --network bsc"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/typeorm": "^10.0.2",
    "@solana/web3.js": "^1.98.4",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^15.4.0",
    "axios": "^1.7.0",
    "bip32": "^5.0.0",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^6.1.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "ecpair": "^3.0.0",
    "ed25519-hd-key": "^1.3.0",
    "ethers": "^6.13.0",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "tiny-secp256k1": "^2.2.4",
    "tronweb": "^6.0.4",
    "typeorm": "^0.3.20",
    "tweetnacl": "^1.0.3",
    "uuid": "^10.0.0",
    "web3": "^4.13.0",
    "winston": "^3.14.0",
    "ws": "^8.18.0",
    "xrpl": "^4.2.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@openzeppelin/contracts": "^5.2.0",
    "eslint": "^9.0.0",
    "hardhat": "^2.28.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "blockchain",
    "web3",
    "ethers",
    "base",
    "exaearn",
    "hardhat",
    "solidity"
  ],
  "license": "MIT"
}
