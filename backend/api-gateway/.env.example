APP_NAME=ExaEarn
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── PostgreSQL Database ─────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=exaearn
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@exaearn.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Sanctum ────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173
SANCTUM_TOKEN_EXPIRATION=1440

# ─── CORS ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Node.js Blockchain Microservice ────────────────────────────
# URL of the Node.js service that monitors blockchain & broadcasts txs
NODE_SERVICE_URL=http://localhost:4000
# Shared secret for authenticating service-to-service calls
NODE_SERVICE_SECRET=
NODE_SERVICE_TIMEOUT=15

# ─── Blockchain RPC ─────────────────────────────────────────────
BLOCKCHAIN_RPC_URL=https://mainnet.base.org

# ─── Wallet Asset Networks ──────────────────────────────────────
EXA_NETWORK=base
USDC_NETWORK=base
USDT_NETWORK=base
XRP_NETWORK=xrpl

# ─── Deposit Confirmations ──────────────────────────────────────
BASE_MIN_CONFIRMATIONS=12
XRPL_MIN_CONFIRMATIONS=1

# ─── Withdrawal Security ────────────────────────────────────────
WITHDRAWAL_COOLDOWN_SECONDS=60
WITHDRAWAL_RATE_PER_MINUTE=3
WITHDRAWAL_MAX_PER_REQUEST=10000
WITHDRAWAL_DAILY_LIMIT=25000
HOT_WALLET_MAX_AUTO=1000
WITHDRAWAL_ANOMALY_THRESHOLD=5000

# ─── API Rate Limiting ──────────────────────────────────────────
API_RATE_LIMIT=120
WEBHOOK_RATE_LIMIT=240

# ─── ExaEarn Security Layer (Exchange-Grade Controls) ───────────
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOGIN_DECAY_SECONDS=60
SECURITY_STRONG_PASSWORD_REGEX=/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^\w\s]).{10,}$/

SECURITY_API_RATE_LIMIT_PER_MINUTE=120
SECURITY_API_SIGNATURE_REQUIRED=false
SECURITY_API_SIGNATURE_TTL=120
SECURITY_API_SIGNATURE_SECRET=
SECURITY_NONCE_TTL_SECONDS=120

SECURITY_ADMIN_REQUIRE_2FA=true
SECURITY_ADMIN_IP_WHITELIST=

SECURITY_WITHDRAWAL_DAILY_LIMIT=10000
SECURITY_WITHDRAWAL_DELAY_SECONDS=60
SECURITY_MAX_WITHDRAWALS_PER_MINUTE=3
SECURITY_MAX_WITHDRAWALS_PER_DAY=20
SECURITY_LARGE_WITHDRAWAL_THRESHOLD=2000

# ─── Key Management ─────────────────────────────────────────────
# NEVER store private keys in Laravel. Keys live in the Node.js service.
# WALLET_PRIVATE_KEY — stored only in Node.js .env
# WITHDRAWAL_SIGNING_KEY — stored only in Node.js .env

TRADE_FEE_COLLECTOR_USER_ID=
TRADE_STREAM_DRIVER=redis
TRADE_STREAM_CHANNEL=exaearn.market.stream
TRADE_STREAM_FALLBACK_TO_HTTP=true
STAKING_ASSET=XRP
STAKING_REWARD_TOKEN=EXA
STAKING_MIN_REWARD_PAYOUT=0.00000001
REFERRAL_ENABLED=true
REFERRAL_REWARD_TOKEN=EXA
REFERRAL_CODE_LENGTH=8
REFERRAL_MAX_DEPTH=3
REFERRAL_REQUIRE_EMAIL_VERIFICATION=true
REFERRAL_REQUIRE_KYC=false
REFERRAL_SUSPEND_HOURS=72
REFERRAL_LEVEL_1_SHARE=0.70
REFERRAL_LEVEL_2_SHARE=0.20
REFERRAL_LEVEL_3_SHARE=0.10
REFERRAL_REWARD_FIRST_DEPOSIT=100
REFERRAL_REWARD_FIRST_TRADE=50
REFERRAL_REWARD_STAKING_PARTICIPATION=75
REFERRAL_REWARD_COURSE_COMPLETION=25
REFERRAL_LEADERBOARD_LIMIT=25
REFERRAL_SHARED_IP_LIMIT=3
REFERRAL_SHARED_FINGERPRINT_LIMIT=2
REFERRAL_SHARED_PAYMENT_METHOD_LIMIT=1
REFERRAL_SHARED_WALLET_LIMIT=1
REWARD_ENGINE_SECRET=
REWARD_TOKEN=EXAPOINT
REWARD_CLAIM_COOLDOWN_SECONDS=30
REWARD_MAX_PER_HOUR=20
REWARD_REQUIRE_EMAIL_VERIFICATION=true
REWARD_REQUIRE_KYC_FOR_HIGH_RISK=false
REWARD_RATE_TRADE_VOLUME=0.001
REWARD_LIMIT_TRADE_VOLUME=250
REWARD_MIN_TRADE_VOLUME=10
REWARD_RATE_REFERRAL=1
REWARD_LIMIT_REFERRAL=500
REWARD_RATE_STAKING=0.01
REWARD_LIMIT_STAKING=100
REWARD_MIN_STAKING=1
REWARD_RATE_EDUCATION=10
REWARD_LIMIT_EDUCATION=50
REWARD_RATE_SPORTS=25
REWARD_LIMIT_SPORTS=100
REWARD_RATE_SPORTS_SPONSORSHIP=15
REWARD_LIMIT_SPORTS_SPONSORSHIP=100
REWARD_RATE_SPORTS_VOTE=5
REWARD_LIMIT_SPORTS_VOTE=50
REWARD_RATE_GAME=2
REWARD_LIMIT_GAME=25
REWARD_RATE_AGRICULTURE=0.005
REWARD_LIMIT_AGRICULTURE=100
REWARD_RATE_DAILY_CHECK_IN=1
REWARD_LIMIT_DAILY_CHECK_IN=1
EXAPOINT_REDIS_CHANNEL=exapoint_updates
EXAPOINT_BALANCE_CACHE_TTL=60
EXAPOINT_RATE_LIMIT_PER_MINUTE=120
EXAPOINT_LARGE_ADJUSTMENT_THRESHOLD=10000
EXAPOINT_CONVERSION_RATE=1000
SPORTS_REWARD_FIRST_PLACE_SHARE=0.5
SPORTS_REWARD_SECOND_PLACE_SHARE=0.3
SPORTS_REWARD_THIRD_PLACE_SHARE=0.2
SPORTS_LEADERBOARD_LIMIT=25
SPORTS_MANUAL_REVIEW_SCORE_THRESHOLD=95
SPORTS_MAX_REWARD_PER_COMPETITION=10000

KYC_PROVIDER=smile
KYC_FALLBACK_PROVIDER=sumsub
KYC_BLACKLIST_COUNTRIES=KP,IR,SY
SMILE_BASE_URL=https://api.smileidentity.com
SMILE_API_KEY=
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_API_KEY=
MARKET_MAKER_ENABLED=true
MARKET_MAKER_SYSTEM_USER_ID=1
MARKET_ANCHOR_SOURCE=binance
MARKET_ANCHOR_MAX_DEVIATION_PERCENT=3
MARKET_SPREAD_MIN_PERCENT=0.2
MARKET_SPREAD_MAX_PERCENT=2.5
MARKET_MAKER_MAX_NOTIONAL_PER_MARKET=500000
MARKET_MAKER_POOL_USAGE_LIMIT_PERCENT=80
MARKET_MAKER_MIN_DEPTH_LEVELS=2
SOR_ENABLED=true
SOR_DEFAULT_MAX_SLIPPAGE_PERCENT=0.5
SOR_EXTERNAL_TIMEOUT_MS=4000
SOR_EXTERNAL_RETRY=2
SOR_EXTERNAL_FEE_PERCENT=0.1

VITE_APP_NAME="${APP_NAME}"


# Profile identity images
PROFILE_IMAGE_MAX_KB=5120
PROFILE_IMAGE_DISK=local
PROFILE_REQUIRE_REVIEW=false
