# ==========================================
# EXAEARN EMAIL SERVICE CONFIGURATION
# ==========================================

# Primary Email Provider
# Options: brevo, resend, postmark
MAIL_PROVIDER=brevo

# Email Transport
# Options: smtp, api
# API requires backend integration
MAIL_MAILER=api

# Default Sender Identity
MAIL_FROM_ADDRESS=no-reply@exaearn.com
MAIL_FROM_NAME="ExaEarn"

# ==========================================
# BREVO CONFIGURATION (PRIMARY)
# ==========================================

BREVO_API_KEY=

# ==========================================
# RESEND CONFIGURATION (BACKUP 1)
# ==========================================

RESEND_API_KEY=

# ==========================================
# POSTMARK CONFIGURATION (BACKUP 2)
# ==========================================

POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound

# ==========================================
# EMAIL FAILOVER CONFIGURATION
# ==========================================

MAIL_FAILOVER_ENABLED=true
MAIL_FAILOVER_ORDER=brevo,resend,postmark

# Retry Configuration
MAIL_MAX_RETRIES=3
MAIL_RETRY_DELAY_SECONDS=5

# ==========================================
# SMTP CONFIGURATION (OPTIONAL)
# ==========================================

MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# ==========================================
# EMAIL QUEUE CONFIGURATION
# ==========================================

MAIL_QUEUE_ENABLED=true
MAIL_QUEUE_NAME=emails


