{
  "name": "exaearn",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "workspaces": [
    "apps/*",
    "backend/services/*",
    "packages/*",
    "blockchain"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "web:dev": "pnpm --filter @exaearn/web dev",
    "web:build": "pnpm --filter @exaearn/web build",
    "admin:dev": "pnpm --filter @exaearn/admin dev",
    "admin:build": "pnpm --filter @exaearn/admin build",
    "website:dev": "pnpm --filter @exaearn/website dev",
    "website:build": "pnpm --filter @exaearn/website build",
    "mobile:dev": "pnpm --filter @exaearn/mobile dev",
    "mobile:android": "pnpm --filter @exaearn/mobile android",
    "mobile:ios": "pnpm --filter @exaearn/mobile ios",
    "backend:api": "php -d extension=gd -d extension=pdo_pgsql -d extension=pgsql backend/api-gateway/artisan serve",
    "legacy:web:build": "pnpm --filter @exaearn/web build"
  },
  "devDependencies": {
    "prisma": "^7.8.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "react-native-worklets": "0.2.0"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.18.0",
      "brace-expansion@>=1 <2": "1.1.18",
      "brace-expansion@>=2 <3": "2.1.4",
      "brace-expansion@>=5 <6": "5.0.9",
      "fast-uri": "3.1.5",
      "form-data": "4.0.6",
      "hono": "4.12.25",
      "immutable@>=4 <5": "4.3.9",
      "js-yaml@>=3 <4": "3.15.1",
      "js-yaml@>=4 <5": "4.3.1",
      "lodash@>=4 <5": "4.18.0",
      "multer@>=2 <3": "2.2.0",
      "nanoid@>=3 <4": "3.3.18",
      "postcss@>=8 <9": "8.5.18",
      "shell-quote": "1.9.0",
      "socket.io-parser@>=4 <5": "4.2.7",
      "tar": "7.5.21",
      "undici@>=6 <7": "6.27.0",
      "ws@>=8 <9": "8.21.0"
    }
  }
}
