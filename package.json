{
  "name": "exaearn",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.34.5",
  "workspaces": [
    "apps/*",
    "backend/services/*",
    "packages/*",
    "blockchain"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "web:dev": "pnpm --filter @exaearn/web dev",
    "web:build": "pnpm --filter @exaearn/web build",
    "admin:dev": "pnpm --filter @exaearn/admin dev",
    "admin:build": "pnpm --filter @exaearn/admin build",
    "website:dev": "pnpm --filter @exaearn/website dev",
    "website:build": "pnpm --filter @exaearn/website build",
    "mobile:dev": "pnpm --filter @exaearn/mobile dev",
    "mobile:android": "pnpm --filter @exaearn/mobile android",
    "mobile:ios": "pnpm --filter @exaearn/mobile ios",
    "backend:api": "php -d extension=gd -d extension=pdo_pgsql -d extension=pgsql backend/api-gateway/artisan serve",
    "legacy:web:build": "pnpm --filter @exaearn/web build"
  },
  "devDependencies": {
    "prisma": "^7.8.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "react-native-worklets": "0.2.0"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.20.0",
      "brace-expansion@>=1 <2": "1.1.21",
      "brace-expansion@>=2 <3": "2.1.7",
      "brace-expansion@>=4 <6": "5.0.12",
      "fast-uri": "3.1.9",
      "form-data": "4.0.6",
      "hono": "4.12.25",
      "immutable@>=4 <5": "4.3.9",
      "js-yaml@>=3 <4": "3.15.2",
      "js-yaml@>=4 <5": "4.3.2",
      "lodash@>=4 <5": "4.18.0",
      "multer@>=2 <3": "2.5.0",
      "nanoid@>=3 <4": "3.3.18",
      "postcss@>=8 <9": "8.5.18",
      "proxy-addr": "2.0.8",
      "shell-quote": "1.11.0",
      "socket.io-parser@>=4 <5": "4.2.7",
      "tar": "7.5.21",
      "undici@>=5 <6": "6.29.1",
      "undici@>=6 <7": "6.29.1",
      "ws@>=8 <9": "8.21.0",
      "@xmldom/xmldom@>=0.9.0 <1": "0.9.12",
      "@xmldom/xmldom@>=0.7.0 <0.9.0": "0.8.15",
      "adm-zip@<0.6.1": "0.6.1",
      "@fastify/busboy@<3.2.2": "3.2.2",
      "body-parser@>=1 <2": "1.20.9",
      "browserslist@>=4 <5": "4.28.7",
      "compression@>=1 <2": "1.8.2",
      "effect@>=3 <4": "3.22.1",
      "engine.io@>=6 <7": "6.6.10",
      "follow-redirects@>=1 <2": "1.16.2",
      "mysql2@>=3 <4": "3.23.1",
      "node-forge@>=1 <2": "1.4.3",
      "source-map-js@>=1 <2": "1.2.2",
      "vite@>=6 <7": "6.4.4",
      "vite@>=7 <8": "7.3.7",
      "vite@>=8 <9": "8.2.4",
      "zod@<4.6.6": "4.6.6"
    }
  }
}
